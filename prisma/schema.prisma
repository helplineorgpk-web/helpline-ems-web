generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String   @unique
  passwordHash      String
  // Permanent account deletion is limited to administrators granted this permission.
  canDeleteAccounts Boolean  @default(false)
  createdAt         DateTime @default(now())

  processedDeletionRequests AccountDeletionRequest[] @relation("DeletionProcessor")
  completedDeletionRequests AccountDeletionRequest[] @relation("DeletionCompleter")
  deletionEvents            AccountDeletionEvent[]
}

model Employee {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeCode String   @unique
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  designation  String
  role         String   @default("STAFF")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments      ProjectAssignment[]
  attendance       Attendance[]
  reports          DailyReport[]
  deletionRequests AccountDeletionRequest[]
}

model ProjectType {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  color     String   @default("stone")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  code        String   @unique
  type        String
  location    String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ProjectAssignment[]
  attendance  Attendance[]
  reports     DailyReport[]
}

model ProjectAssignment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  projectId  String   @db.ObjectId
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Optional so an assignment to a removed project does not fail the employees list.
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([employeeId, projectId])
  @@index([projectId])
}

model Attendance {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String    @db.ObjectId
  projectId  String?   @db.ObjectId
  date       String
  checkInAt  DateTime
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

model DailyReport {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String   @db.ObjectId
  projectId  String   @db.ObjectId
  date       String
  summary    String
  details    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Optional so a report for a removed project does not fail employee and report reads.
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([date])
  @@index([projectId])
}

model Notification {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  type               String    @default("REPORT")
  title              String
  body               String
  reportId           String?   @db.ObjectId
  employeeId         String?   @db.ObjectId
  projectId          String?   @db.ObjectId
  deletionRequestId  String?   @db.ObjectId
  read               Boolean   @default(false)
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

model AccountDeletionRequest {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  employeeId           String?   @db.ObjectId
  employeeCode         String
  employeeName         String
  employeeEmail        String?
  employeePhone        String?
  designation          String
  appRole              String
  employeeStatus       String
  reason               String?
  status               String    @default("PENDING")
  requestedAt          DateTime  @default(now())
  processingAdminId    String?   @db.ObjectId
  processingAdminName  String?
  processingStartedAt  DateTime?
  completedByAdminId   String?   @db.ObjectId
  completedByAdminName String?
  completedAt          DateTime?
  removedAssignments   Int?
  removedAttendance    Int?
  removedReports       Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee         Employee?              @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  processingAdmin  Admin?                 @relation("DeletionProcessor", fields: [processingAdminId], references: [id], onDelete: SetNull)
  completedByAdmin Admin?                 @relation("DeletionCompleter", fields: [completedByAdminId], references: [id], onDelete: SetNull)
  events           AccountDeletionEvent[]

  @@index([status])
  @@index([employeeId])
  @@index([requestedAt])
}

model AccountDeletionEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  requestId String   @db.ObjectId
  action    String
  actorName String
  actorRole String
  adminId   String?  @db.ObjectId
  note      String?
  createdAt DateTime @default(now())

  request AccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin   Admin?                 @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model ApiEndpoint {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  group     String
  method    String
  path      String
  title     String
  auth      String
  body      String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([method, path])
  @@index([group])
}
