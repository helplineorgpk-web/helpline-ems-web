# Local MongoDB (single-node replica set — required by Prisma upserts/transactions)
# Start: mongod --dbpath=/path/to/data/db --replSet rs0 --bind_ip 127.0.0.1
# Then once: rs.initiate({ _id: "rs0", members: [{ _id: 0, host: "127.0.0.1:27017" }] })
DATABASE_URL="mongodb://127.0.0.1:27017/helplineems?replicaSet=rs0&directConnection=true"
MONGODB_URI="mongodb://127.0.0.1:27017/helplineems?replicaSet=rs0&directConnection=true"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Production (Vercel). On Vercel the app uses ATLAS_DATABASE_URL when it is set,
# including when DATABASE_URL still points at localhost.
# ATLAS_DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/helplineems?retryWrites=true&w=majority"
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/helplineems?retryWrites=true&w=majority"
